e' method='post' action='/orders/status'>\"", "-                     f\"<input type='hidden' name='id' value='{o['id']}'><select name='status'>{opts}</select>\"", "-                     f\"<button>تحديث</button></form></td></tr>\")", "+                     f\"<td>{badge(o['status'])}</td><td>\" + (", "+                         f\"<form class='inline' method='post' action='/orders/status'>\"", "+                         f\"<input type='hidden' name='id' value='{o['id']}'><select name='status'>{opts}</select>\"", "+                         f\"<button>تحديث</button></form>\" if nxt else \"<span style='color:var(--mut)'>مكتمل</span>\")", "+                     + \"</td></tr>\")", "+# Allowed transitions: forward one step at a time; cancel only before shipping.", "+TRANSITIONS = {", "+    \"جديد\": {\"قيد التجهيز\", \"ملغي\"},", "+    \"قيد التجهيز\": {\"تم الشحن\", \"ملغي\"},", "+    \"تم الشحن\": {\"تم التسليم\"},", "+    \"تم التسليم\": set(),", "+    \"ملغي\": set(),", "+}", "+", "+CREATE TABLE IF NOT EXISTS order_history (", "+  order_id INTEGER NOT NULL REFERENCES orders(id), status TEXT NOT NULL, at TEXT NOT NULL);", "+        self.db.execute(\"INSERT INTO order_history VALUES (?,?,?)\", (cur.lastrowid, \"جديد\", now()))", "-        self.order(order_id)"], "ok": ["$ python3 -m unittest -v", "test_dashboard_requires_login (tests.test_server.ServerTests.test_dashboard_requires_login) ... ok", "test_login_then_dashboard (tests.test_server.ServerTests.test_login_then_dashboard) ... ok", "test_wrong_password_rejected (tests.test_server.ServerTests.test_wrong_password_rejected) ... ok", "test_login (tests.test_store.AuthTests.test_login) ... ok", "test_password_not_stored_in_plain_text (tests.test_store.AuthTests.test_password_not_stored_in_plain_text) ... ok", "test_create_order_starts_new (tests.test_store.StoreTests.test_create_order_starts_new) ... ok", "test_customer_name_required (tests.test_store.StoreTests.test_customer_name_required) ... ok", "test_customers_list_counts_orders (tests.test_store.StoreTests.test_customers_list_counts_orders) ... ok", "test_dashboard_counts_and_revenue_excludes_cancelled (tests.test_store.StoreTests.test_dashboard_counts_and_revenue_excludes_cancelled) ... ok", "test_rejects_unknown_customer_and_negative_total (tests.test_store.StoreTests.test_rejects_unknown_customer_and_negative_total) ... ok", "test_cannot_cancel_after_shipping (tests.test_transitions.TransitionTests.test_cannot_cancel_after_shipping) ... ok", "test_cannot_skip_to_delivered (tests.test_transitions.TransitionTests.test_cannot_skip_to_delivered) ... ok", "test_history_is_recorded (tests.test_transitions.TransitionTests.test_history_is_recorded) ... ok", "", "----------------------------------------------------------------------", "Ran 13 tests in 0.686s", "", "OK"]}, "code": ["\"\"\"Data layer and business rules for the orders system (SQLite, stdlib only).\"\"\"", "import sqlite3", "from datetime import datetime, timezone", "from .auth import hash_password, verify_password", "STATUSES = [\"جديد\", \"قيد التجهيز\", \"تم الشحن\", \"تم التسليم\", \"ملغي\"]", "# Allowed transitions: forward one step at a time; cancel only before shipping.", "TRANSITIONS = {", "    \"جديد\": {\"قيد التجهيز\", \"ملغي\"},", "    \"قيد التجهيز\": {\"تم الشحن\", \"ملغي\"},", "    \"تم الشحن\": {\"تم التسليم\"},", "    \"تم التسليم\": set(),", "    \"ملغي\": set(),", "}", "SCHEMA = \"\"\"", "CREATE TABLE IF NOT EXISTS users (username TEXT PRIMARY KEY, password TEXT NOT NULL);", "CREATE TABLE IF NOT EXISTS customers (", "  id INTEGER PRIMARY KEY, name TEXT NOT NULL, phone TEXT, city TEXT);", "CREATE TABLE IF NOT EXISTS orders (", "  id INTEGER PRIMARY KEY, customer_id INTEGER NOT NULL REFERENCES customers(id),", "  total REAL NOT NULL CHECK (total >= 0), status TEXT NOT NULL DEFAULT 'جديد',", "  created_at TEXT NOT NULL);", "CREATE TABLE IF NOT EXISTS order_history (", "  order_id INTEGER NOT NULL REFERENCES orders(id), status TEXT NOT NULL, at TEXT NOT NULL);", "\"\"\"", "class OrderError(ValueError):", "    pass", "def now() -> str:", "    return datetime.now(timezone.utc).isoformat(timespec=\"seconds\")", "class Store:", "    def __init__(self, path: str = \":memory:\"):", "        self.db = sqlite3.connect(path, check_same_thread=False)", "        self.db.row_factory = sqlite3.Row", "        self.db.executescript(SCHEMA)", "    # --- users ---", "    def add_user(self, username: str, password: str) -> None:", "        self.db.execute(\"INSERT INTO users VALUES (?, ?)\", (username, hash_password(password)))", "        self.db.commit()", "    def check_login(self, username: str, password: str) -> bool:", "        row = self.db.execute(\"SELECT password FROM users WHERE username=?\", (username,)).fetchone()", "        return bool(row) and verify_password(password, row[\"password\"])", "    # --- customers ---", "    def add_customer(self, name: str, phone: str = \"\", city: str = \"\") -> int:", "        if not name.strip():", "            raise OrderError(\"اسم العميل مطلوب\")", "        cur = self.db.execute(\"INSERT INTO customers (name, phone, city) VALUES (?,?,?)\",", "                              (name.strip(), phone, city))", "        self.db.commit()", "        return cur.lastrowid", "    def customers(self) -> list[dict]:", "        rows = self.db.execute(\"\"\"SELECT c.*, COUNT(o.id) AS orders FROM customers c", "                                  LEFT JOIN orders o ON o.customer_id=c.id GROUP BY c.id ORDER BY c.id\"\"\")", "        return [dict(r) for r in rows]", "    # --- orders ---", "    def create_order(self, customer_id: int, total: float) -> int:", "        if not self.db.execute(\"SELECT 1 FROM customers WHERE id=?\", (customer_id,)).fetchone():", "            raise OrderError(\"العميل غير موجود\")", "        if total < 0:", "            raise OrderError(\"قيمة الطلب لا يمكن أن تكون سالبة\")", "        cur = self.db.execute(\"INSERT INTO orders (customer_id, total, created_at) VALUES (?,?,?)\",", "                              (customer_id, total, now()))", "        self.db.execute(\"INSERT INTO order_history VALUES (?,?,?)\", (cur.lastrowid, \"جديد\", now()))", "        self.db.commit()", "        return cur.lastrowid", "    def order(self, order_id: int) -> dict:", "        row = self.db.execute(\"\"\"SELECT o.*, c.name AS customer FROM orders o", "                                 JOIN customers c ON c.id=o.customer_id WHERE o.id=?\"\"\", (order_id,)).fetchone()", "        if not row:", "            raise OrderError(\"الطلب غير موجود\")", "        return dict(row)", "    def orders(self) -> list[dict]:", "        rows = self.db.execute(\"\"\"SELECT o.*, c.name AS customer FROM orders o", "                                  JOIN customers c ON c.id=o.customer_id ORDER BY o.id DESC\"\"\")", "        return [dict(r) for r in rows]", "    def set_status(self, order_id: int, status: str) -> None:", "        if status not in STATUSES:", "            raise OrderError(\"حالة غير معروفة\")", "        current = self.order(order_id)[\"status\"]", "        if status not in TRANSITIONS[current]:", "            raise OrderError(f\"لا يمكن نقل الطلب من «{current}» إلى «{status}»\")", "        self.db.execute(\"UPDATE orders SET status=? WHERE id=?\", (status, order_id))", "        self.db.execute(\"INSERT INTO order_history VALUES (?,?,?)\", (order_id, status, now()))", "        self.db.commit()", "    def history(self, order_id: int) -> list[dict]:", "        rows = self.db.execute(\"SELECT status, at FROM order_history WHERE order_id=? ORDER BY rowid\",", "                               (order_id,))", "        return [dict(r) for r in rows]", "    def dashboard(self) -> dict:", "        by_status = {s: 0 for s in STATUSES}", "        for r in self.db.execute(\"SELECT status, COUNT(*) n FROM orders GROUP BY status\"):", "            by_status[r[\"status\"]] = r[\"n\"]", "        revenue = self.db.execute(", "            \"SELECT COALESCE(SUM(total),0) FROM orders WHERE status!='ملغي'\").fetchone()[0]", "        return {\"total_orders\": sum(by_status.values()), \"by_status\": by_status,", "                \"revenue\": round(revenue, 2), \"customers\": len(self.customers())}"], "analysis": {"rows": 5000, "late_count": 1027, "late_rate": 20.5, "avg_overrun_late_hours": 23.1, "best_department": {"name": "خدمة العملاء", "late_rate": 16.4, "sat": 3.97}, "departments": [{"name": "خدمة العملاء", "ops": 1014, "late_rate": 16.4, "sat": 3.97}, {"name": "المستودعات", "ops": 1030, "late_rate": 18.1, "sat": 3.87}, {"name": "المشتريات", "ops": 954, "late_rate": 20.3, "sat": 3.88}, {"name": "التوصيل", "ops": 1008, "late_rate": 22.0, "sat": 3.83}, {"name": "الصيانة", "ops": 994, "late_rate": 26.1, "sat": 3.73}], "cities": [{"name": "أبها", "late_rate": 23.9}, {"name": "جدة", "late_rate": 21.5}, {"name": "المدينة المنورة", "late_rate": 21.1}, {"name": "مكة المكرمة", "late_rate": 19.9}, {"name": "الرياض", "late_rate": 19.9}, {"name": "الدمام", "late_rate": 19.2}], "months": [{"name": "يناير", "late_rate": 19.2}, {"name": "فبراير", "late_rate": 21.7}, {"name": "مارس", "late_rate": 21.5}, {"name": "أبريل", "late_rate": 15.8}, {"name": "مايو", "late_rate": 22.1}, {"name": "يونيو", "late_rate": 23.2}, {"name": "يوليو", "late_rate": 23.7}, {"name": "أغسطس", "late_rate": 19.0}, {"name": "سبتمبر", "late_rate": 18.9}], "top_causes": [{"name": "ازدحام الطلبات", "count": 204, "share": 20.5}, {"name": "تأخر المورد", "count": 161, "share": 16.2}, {"name": "نقص المخزون", "count": 159, "share": 16.0}, {"name": "نقص الموظفين", "count": 150, "share": 15.1}, {"name": "عنوان غير دقيق", "count": 127, "share": 12.8}], "anomalies": [{"city": "جدة", "month": "يوليو", "late_rate": 36.4, "ops": 121, "z": 2.98}, {"city": "المدينة المنورة", "month": "يوليو", "late_rate": 36.0, "ops": 50, "z": 2.91}, {"city": "مكة المكرمة", "month": "مايو", "late_rate": 27.4, "ops": 73, "z": 1.32}], "top_anomaly_cause": {"name": "نقص المخزون", "share": 55.8}, "cs_worst_day": {"day": "ال